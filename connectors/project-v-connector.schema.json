{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-v:watchtower:connector:v1",
  "title": "Project V Watchtower Declarative Connector",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "category", "routing", "output"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "name": { "type": "string", "minLength": 3, "maxLength": 100 },
    "category": { "enum": ["alerts", "aviation", "conflict", "economics", "energy", "fire", "markets", "maritime", "news", "weather", "compatibility"] },
    "routing": { "enum": ["local-sidecar", "direct-provider", "project-v-gateway", "optional-upstream"] },
    "endpoint": { "type": "string", "format": "uri" },
    "credentialKeys": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "refreshSeconds": { "type": "integer", "minimum": 30, "maximum": 86400 },
    "cacheSeconds": { "type": "integer", "minimum": 0, "maximum": 604800 },
    "itemsPath": { "type": "string" },
    "mapping": { "type": "object", "additionalProperties": { "type": "string" } },
    "output": { "enum": ["project-v-event-v1", "project-v-metric-v1", "project-v-asset-v1", "project-v-headline-v1"] },
    "notes": { "type": "string", "maxLength": 1000 }
  }
}
